# ============================================================
# ESshop 智能客服服务配置模板
# ============================================================
# 复制此文件为 .env 并填入真实配置（.env 已在 .gitignore 中，不会提交）
# ------------------------------------------------------------

# ==================== Embedding（向量化） ====================
# ollama  本地运行，免费、离线（开发推荐）
# openai  云端兼容接口，需要 Key
EMBEDDING_PROVIDER=ollama

# ---- ollama 模式 ----
OLLAMA_URL=http://localhost:11434
# 中文 embedding 模型，需先执行: ollama pull qwen3-embedding:4b
EMBEDDING_MODEL=qwen3-embedding:4b

# ---- openai 模式（EMBEDDING_PROVIDER=openai 时生效）----
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=

# 首次调用需要加载模型，超时给足
EMBED_TIMEOUT=120

# ==================== LLM（生成） ====================
# openai  兼容 OpenAI 协议的服务（DeepSeek / 通义 / 智谱等）
# ollama  本地 Ollama 模型
LLM_PROVIDER=openai

# ---- openai 模式 ----
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_MODEL=deepseek-chat

# ---- ollama 模式（LLM_PROVIDER=ollama 时生效）----
OLLAMA_LLM_URL=http://localhost:11434/v1
# 需先执行: ollama pull qwen2.5:7b
OLLAMA_LLM_MODEL=qwen2.5:7b

# 生成参数
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=500
LLM_REQUEST_TIMEOUT=60

# ==================== RAG 检索 ====================
# 是否启用 RAG（关闭则退回纯提示词模式）
RAG_ENABLED=true
# 检索条数
RAG_TOP_K=3
# 相似度阈值（低于此值认为不相关）
RAG_MIN_SCORE=0.45

# ==================== 服务端口 ====================
PORT=8000
